# Copy to .env and fill secrets. Restart backend after changes.

# API_GPT_4=
OPENAI_CHAT_MODEL=gpt-5.6-luna
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Web search: TẮT mặc định (không gọi OpenAI web_search tool — phí cao).
# Chỉ bật nếu có Bing: AI_WEB_SEARCH_ENABLED=true và BING_SEARCH_KEY=...
# AI_WEB_SEARCH_ENABLED=true
# BING_SEARCH_KEY=

# --- Giá ước tính dashboard (USD / 1 triệu token) — gpt-5.6-luna ---
OPENAI_PRICE_CHAT_INPUT=0.2
OPENAI_PRICE_CHAT_OUTPUT=1.2
OPENAI_PRICE_EMBED=0.02
OPENAI_USD_TO_VND=32000
