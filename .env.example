PORT=4000
NODE_ENV=development

# MongoDB — không commit mật khẩu thật
MONGODB_URI=mongodb://username:password@localhost:4568/thitracnghiem?authSource=admin

# JWT — sign và verify dùng cùng key (bắt buộc)
ACCESS_TOKEN_KEY=change_me_access_token_secret_long_random
REFRESH_TOKEN_KEY=change_me_refresh_token_secret_long_random

# AES-256 PII (đúng 32 bytes)
SECRET_KEY=12345678901234567890123456789012

# Optional
# API_GPT_4=
